#!/bin/bash
#PBS -N nmee-SS-compare
#PBS -q CP_001
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=8gb
#PBS -l walltime=00:15:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
source /work/sunq/xjq/releases/W90Flow-20260812/site/japan/load_oneapi.sh
ulimit -s unlimited
ulimit -c 0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
python3 -u recheck.py > recheck.log 2>&1
