#!/bin/bash
#PBS -N nmee-7268-zrelax
#PBS -q CP_001
#PBS -l select=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=24gb
#PBS -l walltime=01:50:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
source /work/sunq/xjq/releases/W90Flow-20260812/site/japan/load_oneapi.sh
ulimit -s unlimited
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python3 -u relax_7268.py > A_zrelax.log 2>&1
