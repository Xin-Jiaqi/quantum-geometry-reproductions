#!/bin/bash
#PBS -N nmee-final-gauge
#PBS -q CP_001
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=4gb
#PBS -l walltime=00:05:00
#PBS -j oe
set -euo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
source /work/sunq/xjq/releases/W90Flow-20260812/site/japan/load_oneapi.sh
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python3 -u finalize_anchor.py > final_gauge.log 2>&1
