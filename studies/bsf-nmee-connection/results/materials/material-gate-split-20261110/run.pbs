#!/bin/bash
#PBS -N nmee-gate-split
#PBS -q DP_002
#PBS -l select=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -eo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
source /work/sunq/xjq/releases/W90Flow-20260812/site/japan/load_oneapi.sh
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python3 -u run_split.py > "${LOG_NAME:-split.log}" 2>&1
