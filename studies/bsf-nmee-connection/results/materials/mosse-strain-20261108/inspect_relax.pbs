#!/bin/bash
#PBS -q DP_002
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=2gb
#PBS -l walltime=00:05:00
#PBS -j oe
set -eo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python3 inspect_relax.py
