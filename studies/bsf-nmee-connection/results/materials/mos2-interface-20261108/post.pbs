#!/bin/bash
#PBS -q DP_002
#PBS -l select=1:ncpus=4:mpiprocs=4:ompthreads=1:mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -eo pipefail
test -n "${PBS_JOBID:-}" && test -s "$PBS_NODEFILE"
case "$(hostname -s)" in super*|cms-ssh*) exit 71;; esac
cd "$PBS_O_WORKDIR"
source /work/sunq/xjq/releases/W90Flow-20260812/site/japan/load_oneapi.sh
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
if [ "$STAGE" = export ]; then
  python3 -u export.py
elif [ "$STAGE" = analyze ]; then
  python3 -u analyze.py
  python3 -u electrostatic.py
else
  exit 72
fi
